# Database
DATABASE_URL=postgresql+asyncpg://cricket:cricket@localhost:5432/cricket_shorts

# Storage (leave empty for local ./storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=cricket-shorts-uploads
STORAGE_LOCAL_PATH=./storage

# AI
AI_DEMO_MODE=true
YOLO_MODEL_PATH=
WHISPER_MODEL=base
FFMPEG_PATH=ffmpeg

# Optional: richer titles/descriptions
OPENAI_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Worker
WORKER_POLL_INTERVAL=2
BATCH_INBOX_FOLDER=inbox
BATCH_AUTO_SCAN=true
BATCH_MAX_FILES_PER_SCAN=50
BATCH_SCAN_INTERVAL=10
BATCH_MAX_FILE_SIZE_MB=0

# Short output: 4k (2160x3840, no crop on portrait) | native | 1080
SHORT_OUTPUT_MODE=4k
SHORT_OUTPUT_WIDTH=2160
SHORT_OUTPUT_HEIGHT=3840
SHORT_CRF=18
SHORT_PRESET=slow
SHORT_VIDEO_BITRATE=20M
SHORT_PRESERVE_SOURCE_FPS=true
