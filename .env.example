# Database
DATABASE_URL=postgresql+asyncpg://cricket:cricket@localhost:5432/cricket_shorts

# Storage (leave empty for local ./storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=cricket-shorts-uploads
STORAGE_LOCAL_PATH=./storage

# AI
AI_DEMO_MODE=true
YOLO_MODEL_PATH=
WHISPER_MODEL=base
FFMPEG_PATH=ffmpeg

# Optional: richer titles/descriptions
OPENAI_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Worker
WORKER_POLL_INTERVAL=2
